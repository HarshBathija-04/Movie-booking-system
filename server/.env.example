# Postgres connection string (Render: the shared database's Internal Database URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio
# Each app keeps its tables in its own schema of the shared database
DB_SCHEMA=movie_booking
PORT=5126
NODE_ENV=development
# Long random string; Render generates one automatically
JWT_SECRET=change-me
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5213
# Groq API key for the AI movie concierge (optional; the feature degrades gracefully without it)
GROQ_API_KEY=your-groq-api-key
# Optional: seed creates/updates an admin account with these credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional SMTP for booking confirmation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
