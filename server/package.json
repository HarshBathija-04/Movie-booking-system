{
  "name": "cineverse-api",
  "version": "2.0.0",
  "description": "REST API for the CineVerse movie ticket booking platform (Express + PostgreSQL)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "groq-sdk": "1.6.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "7.0.13",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  }
}
